<?php

declare(strict_types=1);

// phpcs:disable Generic.Files.LineLength.TooLong

use Ideo\Dhl\ViewModel\Adminhtml\Shipment\DatePickerConfig;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var DatePickerConfig $viewModel */

$viewModel = $block->getViewModel();
$dateFormat = $viewModel->getDateFormat();
$todayDate = $viewModel->getFormattedDate();

$infoUrl = $block->getUrl('dhlpoland/shipment/getShipmentPickupInfo');
$bookUrl = $block->getUrl('dhlpoland/shipment/bookCourier');
?>
<div id="ideo-dhl-book-courier-modal" style="display: none;" data-bind="scope: 'dhlBookCourierModal'">
    <form id="ideo-dhl-book-courier-form" onsubmit="return false;">
        <div class="admin__fieldset" style="margin-bottom: 0;">

            <!-- Warning Notice if Needed -->
            <!-- ko if: warningMessage() -->
            <div class="message message-warning warning" style="margin-bottom: 15px;">
                <div data-bind="text: warningMessage"></div>
            </div>
            <!-- /ko -->

            <!-- Selected Shipments Info -->
            <div class="admin__field">
                <label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Selected Shipments')) ?></span></label>
                <div class="admin__field-control" style="padding-top: 6px;">
                    <div><strong><span data-bind="text: selectedShipmentIds().length"></span> <?= $escaper->escapeHtml(__('shipment(s) selected')) ?></strong></div>
                    <!-- ko if: typeof selectedShipmentNumbers !== 'undefined' && selectedShipmentNumbers().length > 0 -->
                    <div style="margin-top: 4px; color: #555; font-size: 1.2rem;">
                        <span><?= $escaper->escapeHtml(__('Shipment IDs:')) ?></span>
                        <span data-bind="text: selectedShipmentNumbers().join(', ')"></span>
                    </div>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Pickup Date Selection -->
            <div class="admin__field required">
                <label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Pickup Date')) ?></span></label>
                <div class="admin__field-control">
                    <input type="text"
                           id="dhlpoland_pickup_date"
                           class="admin__control-text"
                           value="<?= $escaper->escapeHtmlAttr($todayDate) ?>"
                           data-bind="dhlDatepicker: pickupDate, datepickerOptions: { dateFormat: '<?= $escaper->escapeJs($dateFormat) ?>', minDate: 0 }"
                           style="width: 200px; box-sizing: border-box;"
                           required />
                </div>
            </div>

            <!-- Courier Pickup [From - To] -->
            <div class="admin__field required">
                <label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Courier Pickup [From - To]')) ?></span></label>
                <div class="admin__field-control">
                    <div style="display: flex; gap: 8px; width: 260px;">
                        <div style="flex: 1;">
                            <input type="text"
                                   id="dhlpoland_pickup_time_from"
                                   class="admin__control-text"
                                   placeholder="HH:mm"
                                   data-bind="dhlTimepicker: pickupTimeFrom"
                                   style="width: 100%; box-sizing: border-box;"
                                   autocomplete="off"
                                   required />
                        </div>
                        <div style="flex: 1;">
                            <input type="text"
                                   id="dhlpoland_pickup_time_to"
                                   class="admin__control-text"
                                   placeholder="HH:mm"
                                   data-bind="dhlTimepicker: pickupTimeTo"
                                   style="width: 100%; box-sizing: border-box;"
                                   autocomplete="off"
                                   required />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Info for Courier -->
            <div class="admin__field">
                <label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Notes for Courier (Optional)')) ?></span></label>
                <div class="admin__field-control">
                    <textarea class="admin__control-textarea" data-bind="value: additionalInfo" rows="2" placeholder="<?= $escaper->escapeHtmlAttr(__('Instructions for courier pickup...')) ?>"></textarea>
                </div>
            </div>

        </div>
    </form>
</div>

<script type="text/x-magento-init">
{
    "#ideo-dhl-book-courier-modal": {
        "Magento_Ui/js/core/app": {
            "components": {
                "dhlBookCourierModal": {
                    "component": "Ideo_Dhl/js/shipment/book-courier-modal",
                    "infoUrl": "<?= $escaper->escapeUrl($infoUrl) ?>",
                    "bookUrl": "<?= $escaper->escapeUrl($bookUrl) ?>",
                    "dateFormat": "<?= $escaper->escapeJs($dateFormat) ?>"
                }
            }
        }
    }
}
</script>
