<?php

declare(strict_types=1);

use Ideo\Dhl\Model\Config\Source\PnpPackageType;
use Ideo\Dhl\ViewModel\Adminhtml\Shipment\DatePickerConfig;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var DatePickerConfig $viewModel */

$viewModel = $block->getViewModel();
$dateFormat = $viewModel->getDateFormat();
$todayDate = $viewModel->getFormattedDate();
$generateUrl = $block->getUrl('ideo_dhl/shipment/generatePnpReport');

/** @var PnpPackageType $pnpPackageTypeSource */
$pnpPackageTypeSource = $block->getData('pnp_package_type_source') ?? new PnpPackageType();
$packageTypeOptions = $pnpPackageTypeSource->toOptionArray();
?>
<div id="ideo-dhl-pnp-modal" style="display: none;" data-bind="scope: 'dhlPnpModal'">
    <form id="ideo-dhl-pnp-form" action="<?= $escaper->escapeUrl($generateUrl) ?>" method="post">
        <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>" />
        <div class="admin__fieldset" style="margin-bottom: 0;">

            <div class="admin__field required">
                <label class="admin__field-label" for="pnp_date"><span><?= $escaper->escapeHtml(__('Date')) ?></span></label>
                <div class="admin__field-control">
                    <input type="text" id="pnp_date" name="pnp[date]" class="admin__control-text" value="<?= $escaper->escapeHtmlAttr($todayDate) ?>" data-bind="dhlDatepicker: date, datepickerOptions: { dateFormat: '<?= $escaper->escapeJs($dateFormat) ?>', maxDate: new Date() }" style="width: 200px; box-sizing: border-box;" required />
                </div>
            </div>

            <div class="form-group row admin__field required">
                <label class="form-control-label required admin__field-label" for="pnp_typePackage"><span><?= $escaper->escapeHtml(__('Package Type')) ?></span></label>
                <div class="col-sm admin__field-control">
                    <select id="pnp_typePackage" name="pnp[typePackage]" class="custom-select admin__control-select" aria-label="pnp_typePackage input" style="width: 320px;">
                        <?php foreach ($packageTypeOptions as $option): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($option['value']) ?>"<?= $option['value'] === PnpPackageType::TYPE_ALL ? ' selected="selected"' : '' ?>>
                                <?= $escaper->escapeHtml($option['label']) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

        </div>
    </form>
</div>

<script type="text/x-magento-init">
{
    "#ideo-dhl-pnp-modal": {
        "Magento_Ui/js/core/app": {
            "components": {
                "dhlPnpModal": {
                    "component": "Ideo_Dhl/js/shipment/pnp-modal",
                    "generateUrl": "<?= $escaper->escapeUrl($generateUrl) ?>",
                    "dateFormat": "<?= $escaper->escapeJs($dateFormat) ?>"
                }
            }
        }
    }
}
</script>
