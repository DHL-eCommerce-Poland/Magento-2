<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dhlpoland_customs_template_form.dhlpoland_customs_template_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Customs Clearance Template Details</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Ideo\Dhl\Block\Adminhtml\Button\Save"/>
            <button name="save_and_continue" class="Ideo\Dhl\Block\Adminhtml\Button\SaveAndContinue"/>
            <button name="delete" class="Ideo\Dhl\Block\Adminhtml\Button\Delete"/>
            <button name="back" class="Ideo\Dhl\Block\Adminhtml\Button\Back"/>
        </buttons>
        <namespace>dhlpoland_customs_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>dhlpoland_customs_template_form.dhlpoland_customs_template_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dhlpoland_customs_template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="dhlpoland/customstemplate/save"/>
        </settings>
        <dataProvider class="Ideo\Dhl\Model\CustomsTemplate\DataProvider" name="dhlpoland_customs_template_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Basic Information</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="template_name" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Template Name</label>
                <dataScope>template_name</dataScope>
            </settings>
        </field>
        <field name="country_id" formElement="multiselect">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Associated Countries</label>
                <dataScope>country_id</dataScope>
                <notice translate="true">Select countries for this template.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Directory\Model\Config\Source\Country"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="customs_type" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">U</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Customs Clearance Type</label>
                <dataScope>customs_type</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>I</value>
                            <actions>
                                <action name="0">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.individual_customs</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.agreements.invoice_content_agreement</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>U</value>
                            <actions>
                                <action name="0">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.individual_customs</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.agreements.invoice_content_agreement</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>S</value>
                            <actions>
                                <action name="0">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.individual_customs</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>dhlpoland_customs_template_form.dhlpoland_customs_template_form.agreements.invoice_content_agreement</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Source\CustomsType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="category_of_item" formElement="select" component="Ideo_Dhl/js/form/element/customs-category">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Category Of Item</label>
                <dataScope>category_of_item</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Source\CategoryOfItem"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="currency" formElement="select" component="Ideo_Dhl/js/form/element/customs-currency">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">PLN</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Currency</label>
                <dataScope>currency</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Source\CustomsCurrency"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="country_of_origin" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Country of Origin (ISO 3166-1 alpha-2)</label>
                <dataScope>country_of_origin</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Directory\Model\Config\Source\Country"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="costs_of_shipment" formElement="input">
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Gross Costs of Shipment</label>
                <dataScope>costs_of_shipment</dataScope>
            </settings>
        </field>
        <field name="gross_weight" formElement="input">
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Gross Weight (kg)</label>
                <dataScope>gross_weight</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="individual_customs" component="Ideo_Dhl/js/form/components/individual-customs-fieldset">
        <settings>
            <label translate="true">Data for Individual Clearance</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <visible>false</visible>
        </settings>
        <field name="shipper_nip" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Shipper NIP</label>
                <dataScope>shipper_nip</dataScope>
            </settings>
        </field>
        <field name="shipper_eori" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Shipper EORI</label>
                <dataScope>shipper_eori</dataScope>
            </settings>
        </field>
        <field name="receiver_eori" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Receiver EORI</label>
                <dataScope>receiver_eori</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="vat_data">
        <settings>
            <label translate="true">VAT Data</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="shipper_vat_no" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Shipper VAT</label>
                <dataScope>shipper_vat_no</dataScope>
            </settings>
        </field>
        <field name="receiver_vat_no" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Receiver VAT</label>
                <dataScope>receiver_vat_no</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="contact_person">
        <settings>
            <label translate="true">Contact Person</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="contact_first_name" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">First Name</label>
                <dataScope>contact_first_name</dataScope>
            </settings>
        </field>
        <field name="contact_last_name" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Last Name</label>
                <dataScope>contact_last_name</dataScope>
            </settings>
        </field>
        <field name="additional_info" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Additional Information</label>
                <dataScope>additional_info</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="agreements">
        <settings>
            <label translate="true">Agreements and Declarations</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="not_exceed_value" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Value Does Not Exceed Limit</label>
                <dataScope>not_exceed_value</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="not_prohibited_goods" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Shipment Does Not Contain Prohibited Goods</label>
                <dataScope>not_prohibited_goods</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="not_restricted_goods" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Shipment Does Not Contain Restricted Goods</label>
                <dataScope>not_restricted_goods</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <container name="invoice_content_agreement" component="Ideo_Dhl/js/form/components/individual-customs">
            <argument name="data" xsi:type="array">
                <item name="type" xsi:type="string">group</item>
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="template" xsi:type="string">ui/collection</item>
                </item>
            </argument>
            <field name="invoice_content" formElement="checkbox">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="default" xsi:type="number">1</item>
                    </item>
                </argument>
                <settings>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                    <dataType>boolean</dataType>
                    <label translate="true">I declare that the information on the attached invoice is consistent with the customs data entered to generate the shipment</label>
                    <dataScope>invoice_content</dataScope>
                </settings>
                <formElements>
                    <checkbox>
                        <settings>
                            <valueMap>
                                <map name="false" xsi:type="number">0</map>
                                <map name="true" xsi:type="number">1</map>
                            </valueMap>
                            <prefer>toggle</prefer>
                        </settings>
                    </checkbox>
                </formElements>
            </field>
        </container>
    </fieldset>

    <fieldset name="customs_items_fieldset">
        <settings>
            <label translate="true">Customs Items (Goods)</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <dynamicRows name="customs_items" component="Ideo_Dhl/js/dynamic-rows/customs-items">
            <settings>
                <addButtonLabel translate="true">Add Goods Item</addButtonLabel>
                <label translate="true">Goods List</label>
                <componentType>dynamicRows</componentType>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="nameEn" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">English Name</label>
                        <dataScope>nameEn</dataScope>
                    </settings>
                </field>
                <field name="namePl" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Polish Name</label>
                        <dataScope>namePl</dataScope>
                    </settings>
                </field>
                <field name="quantity" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                            <item name="additionalClasses" xsi:type="string">admin__field-xsmall</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>number</dataType>
                        <label translate="true">Quantity</label>
                        <dataScope>quantity</dataScope>
                    </settings>
                </field>
                <field name="weight" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                            <item name="additionalClasses" xsi:type="string">admin__field-xsmall</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>number</dataType>
                        <label translate="true">Weight [kg]</label>
                        <dataScope>weight</dataScope>
                    </settings>
                </field>
                <field name="value" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                            <item name="additionalClasses" xsi:type="string">admin__field-small</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>number</dataType>
                        <label translate="true">Value</label>
                        <dataScope>value</dataScope>
                    </settings>
                </field>
                <field name="tariffCode" formElement="input">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                            <item name="additionalClasses" xsi:type="string">admin__field-small</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Customs Tariff Code</label>
                        <dataScope>tariffCode</dataScope>
                    </settings>
                </field>
                <field name="countryOfOrigin" formElement="select">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                            <item name="additionalClasses" xsi:type="string">admin__field-small</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Country Of Origin</label>
                        <dataScope>countryOfOrigin</dataScope>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Magento\Directory\Model\Config\Source\Country"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <additionalClasses>
                            <class name="data-grid-actions-cell">true</class>
                        </additionalClasses>
                        <dataType>text</dataType>
                        <label translate="true">Akcje</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
</form>
