<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dhlparcel_delivery_service_listing.dhlparcel_delivery_service_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Delivery Service</label>
            </button>
        </buttons>
        <spinner>dhlparcel_delivery_service_columns</spinner>
        <deps>
            <dep>dhlparcel_delivery_service_listing.dhlparcel_delivery_service_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dhlparcel_delivery_service_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="dhlparcel_delivery_service_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected delivery services?</message>
                        <title translate="true">Delete delivery services</title>
                    </confirm>
                    <url path="dhlparcel/deliveryservice/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="dhlparcel_delivery_service_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="template_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Template Name</label>
            </settings>
        </column>
        <column name="service_code" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Ideo\Dhl\Model\Config\Source\ServiceCode"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Service Code</label>
            </settings>
        </column>
        <column name="method_code" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Ideo\Dhl\Model\Config\Source\ShippingMethod"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Associated Shipping Method</label>
            </settings>
        </column>
        <column name="package_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Ideo\Dhl\Model\Config\Source\PackageType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Shipment Type</label>
            </settings>
        </column>
        <column name="weight">
            <settings>
                <filter>text</filter>
                <label translate="true">Weight (kg)</label>
            </settings>
        </column>
        <column name="auto_create_return_shipment" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Auto Return</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Ideo\Dhl\Ui\Component\Listing\Column\DeliveryServiceActions">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
