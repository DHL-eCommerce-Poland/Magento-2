<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dhlparcel_delivery_service_form.dhlparcel_delivery_service_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Delivery Service Details</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Ideo\Dhl\Block\Adminhtml\Button\Save"/>
            <button name="save_and_continue" class="Ideo\Dhl\Block\Adminhtml\Button\SaveAndContinue"/>
            <button name="delete" class="Ideo\Dhl\Block\Adminhtml\Button\Delete"/>
            <button name="back" class="Ideo\Dhl\Block\Adminhtml\Button\Back"/>
        </buttons>
        <namespace>dhlparcel_delivery_service_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dhlparcel_delivery_service_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="dhlparcel/deliveryservice/save"/>
        </settings>
        <dataProvider class="Ideo\Dhl\Model\DeliveryService\DataProvider" name="dhlparcel_delivery_service_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General Configuration</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="template_name" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Template Name</label>
                <dataScope>template_name</dataScope>
            </settings>
        </field>
        <field name="address_type" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">N</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address Type</label>
                <dataScope>address_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\AddressType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="method_code" formElement="multiselect">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Associated Shipping Method</label>
                <dataScope>method_code</dataScope>
                <notice translate="true">Select DHL methods for this template.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\ShippingMethod"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="label_type" formElement="select">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Shipment Label Format</label>
                <dataScope>label_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\LabelType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="content" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Package Contents Description</label>
                <notice translate="true">Available tags: {item_id}, {order_id}, {quote_item_id}, {product_id}, {sku}, {product_name}, {order_description}</notice>
                <dataScope>content</dataScope>
            </settings>
        </field>
        <field name="comment" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Additional Comments</label>
                <notice translate="true">Available tags: {item_id}, {order_id}, {quote_item_id}, {product_id}, {sku}, {product_name}, {order_description}</notice>
                <dataScope>comment</dataScope>
            </settings>
        </field>
        <field name="reference" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Shipment Reference Number</label>
                <notice translate="true">Available tags: {item_id}, {order_id}, {quote_item_id}, {product_id}, {sku}, {product_name}, {order_description}</notice>
                <dataScope>reference</dataScope>
            </settings>
        </field>
        <field name="mpk" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">MPK</label>
                <notice translate="true">Cost center code. Available tags: {item_id}, {order_id}, {quote_item_id}, {product_id}, {sku}, {product_name}, {order_description}</notice>
                <dataScope>mpk</dataScope>
            </settings>
        </field>
        <field name="auto_create_return_shipment" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Generate return label automatically when creating shipment</label>
                <dataScope>auto_create_return_shipment</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>0</value>
                            <actions>
                                <action name="0">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_label_type</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_qr_code_type</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_label_exp_days</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_book_courier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>1</value>
                            <actions>
                                <action name="0">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_label_type</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_qr_code_type</target>
                                    <callback>show</callback>
                                </action>
                                <action name="2">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_label_exp_days</target>
                                    <callback>show</callback>
                                </action>
                                <action name="3">
                                    <target>dhlparcel_delivery_service_form.dhlparcel_delivery_service_form.general.return_book_courier</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="return_label_type" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Return Label Format</label>
                <dataScope>return_label_type</dataScope>
                <imports>
                    <link name="visible">${$.provider}:data.auto_create_return_shipment</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\LabelType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="return_qr_code_type" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Return QR Code Type</label>
                <dataScope>return_qr_code_type</dataScope>
                <imports>
                    <link name="visible">${$.provider}:data.auto_create_return_shipment</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\ReturnQrCodeType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="return_label_exp_days" formElement="input">
            <settings>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Return Label Expiration (Days)</label>
                <dataScope>return_label_exp_days</dataScope>
                <imports>
                    <link name="visible">${$.provider}:data.auto_create_return_shipment</link>
                </imports>
            </settings>
        </field>
        <field name="return_book_courier" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Return Dispatch Method</label>
                <dataScope>return_book_courier</dataScope>
                <imports>
                    <link name="visible">${$.provider}:data.auto_create_return_shipment</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ideo\Dhl\Model\Config\Source\ReturnBookCourier"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="additional_services">
