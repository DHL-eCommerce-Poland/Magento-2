<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dhlpoland_customs_template_listing.dhlpoland_customs_template_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Customs Clearance Template</label>
            </button>
        </buttons>
        <spinner>dhlpoland_customs_template_columns</spinner>
        <deps>
            <dep>dhlpoland_customs_template_listing.dhlpoland_customs_template_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dhlpoland_customs_template_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="dhlpoland_customs_template_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected customs clearances?</message>
                        <title translate="true">Delete customs clearances</title>
                    </confirm>
                    <url path="dhlpoland/customstemplate/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="dhlpoland_customs_template_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="template_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Template Name</label>
            </settings>
        </column>
        <column name="customs_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="DhlPoland\Dhl\Model\Source\CustomsType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Customs Type</label>
            </settings>
        </column>
        <column name="category_of_item" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="DhlPoland\Dhl\Model\Source\CategoryOfItem"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Category Of Item</label>
            </settings>
        </column>
        <column name="currency" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="DhlPoland\Dhl\Model\Source\CustomsCurrency"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Currency</label>
            </settings>
        </column>
        <column name="country_of_origin" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Directory\Model\Config\Source\Country"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Country Of Origin</label>
            </settings>
        </column>
        <column name="country_id">
            <settings>
                <filter>text</filter>
                <dataType>text</dataType>
                <label translate="true">Associated Countries</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="DhlPoland\Dhl\Ui\Component\Listing\Column\CustomsTemplateActions">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
