<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dhlparcel_shipment_listing.dhlparcel_shipment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="generate_pnp" class="Ideo\Dhl\Block\Adminhtml\Button\GeneratePnp"/>
        </buttons>
        <spinner>dhlparcel_shipment_columns</spinner>
        <deps>
            <dep>dhlparcel_shipment_listing.dhlparcel_shipment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dhlparcel_shipment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="dhlparcel_shipment_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="print_label">
                <settings>
                    <url path="dhlparcel/shipment/massPrintLabel"/>
                    <type>print_label</type>
                    <label translate="true">Print Labels</label>
                </settings>
            </action>
            <action name="download_scan">
                <settings>
                    <url path="dhlparcel/shipment/massDownloadScan"/>
                    <type>download_scan</type>
                    <label translate="true">Download Scans</label>
                </settings>
            </action>
            <action name="download_epod">
                <settings>
                    <url path="dhlparcel/shipment/massDownloadEpod"/>
                    <type>download_epod</type>
                    <label translate="true">Download ePODs</label>
                </settings>
            </action>
            <action name="update_status">
                <settings>
                    <url path="dhlparcel/shipment/massUpdateStatus"/>
                    <type>update_status</type>
                    <label translate="true">Update Status</label>
                </settings>
            </action>
            <action name="book_courier">
                <settings>
                    <type>book_courier</type>
                    <label translate="true">Order Courier</label>
                    <url path="dhlparcel/shipment/bookCourier"/>
                    <callback>
                        <provider>dhlparcel_shipment_listing.dhlparcel_shipment_listing.dhlparcel_shipment_columns.actions</provider>
                        <target>bookCourierSelected</target>
                    </callback>
                </settings>
            </action>
            <action name="cancel_courier">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to cancel courier booking for the selected shipments?</message>
                        <title translate="true">Cancel Courier Booking</title>
                    </confirm>
                    <url path="dhlparcel/shipment/massCancelCourierBooking"/>
                    <type>cancel_courier</type>
                    <label translate="true">Cancel Courier Booking</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected shipments? They will be cancelled in DHL and removed from Magento.</message>
                        <title translate="true">Delete Shipments</title>
                    </confirm>
                    <url path="dhlparcel/shipment/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete Shipments</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="dhlparcel_shipment_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="order_increment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order #</label>
            </settings>
        </column>
        <column name="shipment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Shipment ID</label>
            </settings>
        </column>
        <column name="dispatch_number">
            <settings>
                <filter>text</filter>
                <label translate="true">Courier Dispatch ID</label>
            </settings>
        </column>
        <column name="package_numbers" class="Ideo\Dhl\Ui\Component\Listing\Column\PackageNumbers">
            <settings>
                <filter>text</filter>
                <label translate="true">Package Number</label>
            </settings>
        </column>
        <column name="return_shipment_id" class="Ideo\Dhl\Ui\Component\Listing\Column\ReturnShipmentId">
            <settings>
                <filter>text</filter>
                <label translate="true">Return Package Number</label>
            </settings>
        </column>
        <column name="status">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Ideo\Dhl\Ui\Component\Listing\Column\ShipmentActions" component="Ideo_Dhl/js/grid/columns/actions">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
