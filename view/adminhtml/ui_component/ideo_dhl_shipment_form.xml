                <dataScope>sender.name</dataScope>
            </settings>
        </field>
        <field name="sender[firstName]" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">First Name</label>
                <dataScope>sender.firstName</dataScope>
            </settings>
        </field>
        <field name="sender[lastName]" formElement="input">
            <settings>
                <dataType>text</dataType>
