                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">UBEZP - Insurance</label>
                <dataScope>specialServices.insurance</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>0</value>
                            <actions>
                                <action name="0">
                                    <target>ideo_dhl_shipment_form.ideo_dhl_shipment_form.special_services.specialServices[insuranceValue]</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>1</value>
                            <actions>
                                <action name="0">
                                    <target>ideo_dhl_shipment_form.ideo_dhl_shipment_form.special_services.specialServices[insuranceValue]</target>
