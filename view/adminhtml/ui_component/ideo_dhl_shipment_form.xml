<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ideo_dhl_shipment_form.ideo_dhl_shipment_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">DHL Shipment Details</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ideo\Dhl\Block\Adminhtml\Button\Back"/>
            <button name="print_label" class="Ideo\Dhl\Block\Adminhtml\Button\PrintLabel"/>
            <button name="track_shipment" class="Ideo\Dhl\Block\Adminhtml\Button\TrackShipment"/>
            <button name="update_status" class="Ideo\Dhl\Block\Adminhtml\Button\UpdateStatusShipment"/>
            <button name="book_courier" class="Ideo\Dhl\Block\Adminhtml\Button\BookCourierShipment"/>
            <button name="cancel_courier" class="Ideo\Dhl\Block\Adminhtml\Button\CancelCourierShipment"/>
            <button name="recreate" class="Ideo\Dhl\Block\Adminhtml\Button\RecreateShipment"/>
            <button name="delete" class="Ideo\Dhl\Block\Adminhtml\Button\DeleteShipment"/>
        </buttons>
        <namespace>ideo_dhl_shipment_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ideo_dhl_shipment_form.ideo_dhl_shipment_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ideo_dhl_shipment_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ideo_dhl/shipment/save"/>
        </settings>
        <dataProvider class="Ideo\Dhl\Model\Shipment\DataProvider" name="ideo_dhl_shipment_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
            <visible>false</visible>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
    </fieldset>

