                <dataScope>sender.houseNumber</dataScope>
            </settings>
        </field>
        <field name="sender[flatNumber]" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Apt No.</label>
                <dataScope>sender.flatNumber</dataScope>
            </settings>
        </field>
        <field name="sender[postalCode]" formElement="input">
            <settings>
                <dataType>text</dataType>
