<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ideo_dhl_tablerate" resource="default" engine="innodb" comment="Ideo DHL Shipping Table Rates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="varchar" name="method_code" length="32" nullable="false" comment="Shipping Method Code"/>
        <column xsi:type="varchar" name="condition_type" length="16" nullable="false" comment="Condition Type (weight/subtotal)"/>
        <column xsi:type="decimal" name="condition_from" precision="12" scale="4" nullable="false" default="0.0000" comment="Condition From Value"/>
        <column xsi:type="decimal" name="condition_to" precision="12" scale="4" nullable="false" default="0.0000" comment="Condition To Value"/>
        <column xsi:type="decimal" name="price" precision="12" scale="4" nullable="false" default="0.0000" comment="Shipping Price"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNQ_IDEO_DHL_TABLERATE_LOOKUP">
            <column name="website_id"/>
            <column name="method_code"/>
            <column name="condition_type"/>
            <column name="condition_from"/>
            <column name="condition_to"/>
        </constraint>
        <index referenceId="IDX_IDEO_DHL_TABLERATE_MATCH" indexType="btree">
            <column name="website_id"/>
            <column name="method_code"/>
            <column name="condition_type"/>
        </index>
    </table>
</schema>
