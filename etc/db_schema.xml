<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="dhlpoland_tablerate" resource="default" engine="innodb" comment="DHL eCommerce Poland Shipping Table Rates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="varchar" name="method_code" length="32" nullable="false" comment="Shipping Method Code"/>
        <column xsi:type="varchar" name="condition_type" length="16" nullable="false" comment="Condition Type (weight/subtotal)"/>
        <column xsi:type="decimal" name="condition_from" precision="12" scale="4" nullable="false" default="0.0000" comment="Condition From Value"/>
        <column xsi:type="decimal" name="condition_to" precision="12" scale="4" nullable="false" default="0.0000" comment="Condition To Value"/>
        <column xsi:type="decimal" name="price" precision="12" scale="4" nullable="false" default="0.0000" comment="Shipping Price"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNQ_DHLPOLAND_TABLERATE_LOOKUP">
            <column name="website_id"/>
            <column name="method_code"/>
            <column name="condition_type"/>
            <column name="condition_from"/>
            <column name="condition_to"/>
        </constraint>
        <index referenceId="IDX_DHLPOLAND_TABLERATE_MATCH" indexType="btree">
            <column name="website_id"/>
            <column name="method_code"/>
            <column name="condition_type"/>
        </index>
    </table>
    <table name="dhlpoland_country_rate" resource="default" engine="innodb" comment="DHL eCommerce Poland International Country Rates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="varchar" name="method_code" length="32" nullable="false" default="connect" comment="Shipping Method Code"/>
        <column xsi:type="varchar" name="country_id" length="2" nullable="false" comment="Destination Country ISO-2"/>
        <column xsi:type="decimal" name="price" precision="12" scale="4" nullable="false" default="0.0000" comment="Shipping Price"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNQ_DHLPOLAND_COUNTRY_RATE_LOOKUP">
            <column name="website_id"/>
            <column name="method_code"/>
            <column name="country_id"/>
        </constraint>
    </table>
    <table name="quote_address" resource="checkout" comment="Sales Flat Quote Address">
        <column xsi:type="varchar" name="dhl_service_point_id" length="64" nullable="true" comment="DHL Service Point ID (SAP)"/>
        <column xsi:type="varchar" name="dhl_service_point_name" length="255" nullable="true" comment="DHL Service Point Name"/>
        <column xsi:type="varchar" name="dhl_service_point_street" length="255" nullable="true" comment="DHL Service Point Street"/>
        <column xsi:type="varchar" name="dhl_service_point_postcode" length="32" nullable="true" comment="DHL Service Point Postcode"/>
        <column xsi:type="varchar" name="dhl_service_point_city" length="255" nullable="true" comment="DHL Service Point City"/>
        <column xsi:type="smallint" name="dhl_is_packstation" unsigned="true" nullable="false" default="0" comment="DHL Is Packstation (DE)"/>
        <column xsi:type="smallint" name="dhl_is_postfiliale" unsigned="true" nullable="false" default="0" comment="DHL Is Postfiliale"/>
        <column xsi:type="varchar" name="dhl_postnummer" length="64" nullable="true" comment="DHL Postnummer (DE Customer ID)"/>
    </table>
    <table name="sales_order_address" resource="sales" comment="Sales Flat Order Address">
        <column xsi:type="varchar" name="dhl_service_point_id" length="64" nullable="true" comment="DHL Service Point ID (SAP)"/>
        <column xsi:type="varchar" name="dhl_service_point_name" length="255" nullable="true" comment="DHL Service Point Name"/>
        <column xsi:type="varchar" name="dhl_service_point_street" length="255" nullable="true" comment="DHL Service Point Street"/>
        <column xsi:type="varchar" name="dhl_service_point_postcode" length="32" nullable="true" comment="DHL Service Point Postcode"/>
        <column xsi:type="varchar" name="dhl_service_point_city" length="255" nullable="true" comment="DHL Service Point City"/>
        <column xsi:type="smallint" name="dhl_is_packstation" unsigned="true" nullable="false" default="0" comment="DHL Is Packstation (DE)"/>
        <column xsi:type="smallint" name="dhl_is_postfiliale" unsigned="true" nullable="false" default="0" comment="DHL Is Postfiliale"/>
        <column xsi:type="varchar" name="dhl_postnummer" length="64" nullable="true" comment="DHL Postnummer (DE Customer ID)"/>
    </table>

    <table name="dhlpoland_drop_off_point_template" resource="default" engine="innodb" comment="DHL Drop-Off Point Templates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="template_name" length="255" nullable="false" comment="Profile Template Name"/>
        <column xsi:type="varchar" name="sender_name" length="255" nullable="false" comment="Sender Name"/>
        <column xsi:type="varchar" name="first_name" length="255" nullable="true" comment="First Name"/>
        <column xsi:type="varchar" name="last_name" length="255" nullable="true" comment="Last Name"/>
        <column xsi:type="varchar" name="street" length="255" nullable="false" comment="Street"/>
        <column xsi:type="varchar" name="house_number" length="32" nullable="false" comment="House Number"/>
        <column xsi:type="varchar" name="postal_code" length="32" nullable="false" comment="Postal Code"/>
        <column xsi:type="varchar" name="city" length="255" nullable="false" comment="City"/>
        <column xsi:type="varchar" name="email" length="255" nullable="true" comment="Notification Email"/>
        <column xsi:type="varchar" name="phone" length="64" nullable="true" comment="Phone Number"/>
        <column xsi:type="varchar" name="sap_number" length="64" nullable="true" comment="SAP Customer Number"/>
        <column xsi:type="varchar" name="pickup_time_from" length="16" nullable="true" comment="Courier Pickup Time From"/>
        <column xsi:type="varchar" name="pickup_time_to" length="16" nullable="true" comment="Courier Pickup Time To"/>
        <column xsi:type="smallint" name="is_default" unsigned="true" nullable="false" default="0" comment="Is Default"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="dhlpoland_delivery_service_template" resource="default" engine="innodb" comment="DHL Delivery Service Templates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="template_name" length="255" nullable="false" comment="Template Name"/>
        <column xsi:type="varchar" name="method_code" length="1024" nullable="true" comment="Magento Shipping Method Code"/>
        <column xsi:type="varchar" name="content" length="255" nullable="true" comment="Package Contents Description"/>
        <column xsi:type="varchar" name="comment" length="255" nullable="true" comment="Special Comments"/>
        <column xsi:type="varchar" name="reference" length="255" nullable="true" comment="Reference Number"/>
        <column xsi:type="varchar" name="mpk" length="64" nullable="true" comment="MPK Cost Center Code"/>
        <column xsi:type="text" name="additional_services" nullable="true" comment="Additional Services JSON"/>
        <column xsi:type="text" name="packages" nullable="true" comment="Packages JSON Array"/>
        <column xsi:type="varchar" name="label_type" length="32" nullable="false" default="BLP" comment="Shipment Label Format"/>
        <column xsi:type="varchar" name="address_type" length="16" nullable="true" default="N" comment="Address Type (C/B/N)"/>
        <column xsi:type="smallint" name="auto_create_return_shipment" unsigned="true" nullable="false" default="0" comment="Auto Create Return Shipment"/>
        <column xsi:type="varchar" name="return_label_type" length="32" nullable="true" comment="Return Label Type"/>
        <column xsi:type="varchar" name="return_qr_code_type" length="32" nullable="true" comment="Return QR Code Type"/>
        <column xsi:type="int" name="return_label_exp_days" unsigned="true" nullable="true" comment="Return Label Expiration Days"/>
        <column xsi:type="smallint" name="return_book_courier" unsigned="true" nullable="true" default="0" comment="Return Book Courier Method"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="IDX_DHLPOLAND_DELIVERY_SERVICE_TEMPLATE_METHOD" indexType="btree">
            <column name="method_code"/>
        </index>
    </table>
    <table name="dhlpoland_customs_template" resource="default" engine="innodb" comment="DHL Customs Clearance Templates">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="template_name" length="255" nullable="false" comment="Template Name"/>
        <column xsi:type="varchar" name="customs_type" length="1" nullable="false" default="U" comment="Customs Type (U-Simplified, I-Individual, S-Short)"/>
        <column xsi:type="varchar" name="category_of_item" length="2" nullable="false" default="11" comment="Category Of Item (9, 11, 21, 31, 32, 91)"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="PLN" comment="Currency ISO Code"/>
        <column xsi:type="varchar" name="default_tariff_code" length="10" nullable="true" comment="Default HS Tariff Code"/>
        <column xsi:type="varchar" name="shipper_eori" length="35" nullable="true" comment="Shipper EORI Number"/>
        <column xsi:type="varchar" name="shipper_nip" length="35" nullable="true" comment="Shipper NIP Number"/>
        <column xsi:type="varchar" name="shipper_vat_no" length="35" nullable="true" comment="Shipper VAT Registration Number"/>
        <column xsi:type="varchar" name="country_of_origin" length="2" nullable="true" default="PL" comment="Country Of Origin Code"/>
        <column xsi:type="decimal" name="costs_of_shipment" precision="12" scale="4" nullable="true" comment="Costs Of Shipment Gross Value"/>
        <column xsi:type="decimal" name="gross_weight" precision="12" scale="4" nullable="true" comment="Gross Weight in KG"/>
        <column xsi:type="varchar" name="receiver_eori" length="35" nullable="true" comment="Receiver EORI Number"/>
        <column xsi:type="varchar" name="receiver_vat_no" length="35" nullable="true" comment="Receiver VAT Registration Number"/>
        <column xsi:type="varchar" name="contact_first_name" length="30" nullable="true" comment="Contact First Name"/>
        <column xsi:type="varchar" name="contact_last_name" length="30" nullable="true" comment="Contact Last Name"/>
        <column xsi:type="varchar" name="additional_info" length="100" nullable="true" comment="Additional Customs Info"/>
        <column xsi:type="smallint" name="not_exceed_value" unsigned="true" nullable="true" default="1" comment="Agreement: Not Exceed Value Limit"/>
        <column xsi:type="smallint" name="not_prohibited_goods" unsigned="true" nullable="true" default="1" comment="Agreement: Not Prohibited Goods"/>
        <column xsi:type="smallint" name="not_restricted_goods" unsigned="true" nullable="true" default="1" comment="Agreement: Not Restricted Goods"/>
        <column xsi:type="text" name="customs_items" nullable="true" comment="Customs Items JSON Array"/>
        <column xsi:type="text" name="country_id" nullable="true" comment="Destination Countries (comma-separated ISO codes)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="dhlpoland_shipment" resource="default" engine="innodb" comment="DHL Shipment Entities">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Magento Order ID"/>
        <column xsi:type="int" name="magento_shipment_id" unsigned="true" nullable="true" comment="Magento Sales Shipment ID"/>
        <column xsi:type="varchar" name="shipment_id" length="64" nullable="true" comment="DHL Shipment ID"/>
        <column xsi:type="varchar" name="return_shipment_id" length="1024" nullable="true" comment="DHL Return Shipment ID"/>
        <column xsi:type="varchar" name="package_numbers" length="1024" nullable="true" comment="DHL Package Numbers"/>
        <column xsi:type="varchar" name="dispatch_number" length="64" nullable="true" comment="DHL Courier Order / Dispatch Number"/>
        <column xsi:type="varchar" name="status" length="64" nullable="false" default="pending" comment="Shipment Status"/>
        <column xsi:type="varchar" name="drop_off_point_template_id" length="64" nullable="true" comment="Selected Drop-Off Point Template ID"/>
        <column xsi:type="varchar" name="delivery_service_template_id" length="64" nullable="true" comment="Selected Delivery Service Template ID"/>
        <column xsi:type="varchar" name="customs_template_id" length="64" nullable="true" comment="Selected Customs Template ID"/>
        <column xsi:type="text" name="shipment_data" nullable="true" comment="Serialized DhlShipmentData JSON"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="IDX_DHLPOLAND_SHIPMENT_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="IDX_DHLPOLAND_SHIPMENT_MAGENTO_SHIPMENT_ID" indexType="btree">
            <column name="magento_shipment_id"/>
        </index>
        <index referenceId="IDX_DHLPOLAND_SHIPMENT_SHIPMENT_ID" indexType="btree">
            <column name="shipment_id"/>
        </index>
        <index referenceId="IDX_DHLPOLAND_SHIPMENT_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
