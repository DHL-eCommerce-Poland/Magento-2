<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="DhlPoland\Dhl\Api\Data\DropOffPointInterface" type="DhlPoland\Dhl\Model\DropOffPoint" />
    <preference for="DhlPoland\Dhl\Api\DropOffPointRepositoryInterface" type="DhlPoland\Dhl\Model\DropOffPointRepository" />
    <preference for="DhlPoland\Dhl\Api\Data\DeliveryServiceInterface" type="DhlPoland\Dhl\Model\DeliveryService" />
    <preference for="DhlPoland\Dhl\Api\DeliveryServiceRepositoryInterface" type="DhlPoland\Dhl\Model\DeliveryServiceRepository" />
    <preference for="DhlPoland\Dhl\Api\Data\ShipmentDataInterface" type="DhlPoland\Dhl\Model\ShipmentData" />
    <preference for="DhlPoland\Dhl\Api\ShipmentDataRepositoryInterface" type="DhlPoland\Dhl\Model\ShipmentDataRepository" />

    <preference for="DhlPoland\Dhl\Model\Api\ClientInterface" type="DhlPoland\Dhl\Model\Api\SoapClientAdapter" />

    <virtualType name="DhlPolandDhlApiLoggerHandler" type="DhlPoland\Dhl\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>

    <virtualType name="DhlPolandDhlApiLogger" type="DhlPoland\Dhl\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">dhl_api</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">DhlPolandDhlApiLoggerHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="DhlPoland\Dhl\Model\Api\SoapClientAdapter">
        <arguments>
            <argument name="logger" xsi:type="object">DhlPolandDhlApiLogger</argument>
            <argument name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</argument>
            <argument name="apiOrigin" xsi:type="string">Luma_M2</argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Api\ShippingInformationManagementInterface">
        <plugin name="dhlpoland_save_service_point_to_quote_address"
                type="DhlPoland\Dhl\Plugin\Checkout\SaveServicePointToQuoteAddress"
                sortOrder="10" />
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrderAddress">
        <plugin name="dhlpoland_copy_service_point_to_order_address"
                type="DhlPoland\Dhl\Plugin\Quote\CopyServicePointToOrderAddress"
                sortOrder="10" />
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrder">
        <plugin name="dhlpoland_enrich_order_shipping_description"
                type="DhlPoland\Dhl\Plugin\Quote\EnrichOrderShippingDescription"
                sortOrder="10" />
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="dhlpoland_drop_off_point_listing_data_source"
                      xsi:type="string">DhlPoland\Dhl\Model\ResourceModel\DropOffPoint\Grid\Collection</item>
                <item name="dhlpoland_delivery_service_listing_data_source"
                      xsi:type="string">DhlPoland\Dhl\Model\ResourceModel\DeliveryService\Grid\Collection</item>
                <item name="dhlpoland_shipment_listing_data_source"
                      xsi:type="string">DhlPoland\Dhl\Model\ResourceModel\ShipmentData\Grid\Collection</item>
                <item name="dhlpoland_customs_template_listing_data_source"
                      xsi:type="string">DhlPoland\Dhl\Model\ResourceModel\CustomsTemplate\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
