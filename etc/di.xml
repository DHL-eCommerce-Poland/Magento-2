<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ideo\Dhl\Api\Data\DropOffPointInterface" type="Ideo\Dhl\Model\DropOffPoint" />
    <preference for="Ideo\Dhl\Api\DropOffPointRepositoryInterface" type="Ideo\Dhl\Model\DropOffPointRepository" />
    <preference for="Ideo\Dhl\Api\Data\DeliveryServiceInterface" type="Ideo\Dhl\Model\DeliveryService" />
    <preference for="Ideo\Dhl\Api\DeliveryServiceRepositoryInterface" type="Ideo\Dhl\Model\DeliveryServiceRepository" />
    <preference for="Ideo\Dhl\Api\Data\ShipmentDataInterface" type="Ideo\Dhl\Model\ShipmentData" />
    <preference for="Ideo\Dhl\Api\ShipmentDataRepositoryInterface" type="Ideo\Dhl\Model\ShipmentDataRepository" />

    <preference for="Ideo\Dhl\Model\Api\ClientInterface" type="Ideo\Dhl\Model\Api\SoapClientAdapter" />

    <virtualType name="IdeoDhlApiLoggerHandler" type="Ideo\Dhl\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>

    <virtualType name="IdeoDhlApiLogger" type="Ideo\Dhl\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">dhl_api</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">IdeoDhlApiLoggerHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Ideo\Dhl\Model\Api\SoapClientAdapter">
        <arguments>
            <argument name="logger" xsi:type="object">IdeoDhlApiLogger</argument>
            <argument name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Api\ShippingInformationManagementInterface">
        <plugin name="dhlparcel_save_service_point_to_quote_address"
                type="Ideo\Dhl\Plugin\Checkout\SaveServicePointToQuoteAddress"
                sortOrder="10" />
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrderAddress">
        <plugin name="dhlparcel_copy_service_point_to_order_address"
                type="Ideo\Dhl\Plugin\Quote\CopyServicePointToOrderAddress"
                sortOrder="10" />
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrder">
        <plugin name="dhlparcel_enrich_order_shipping_description"
                type="Ideo\Dhl\Plugin\Quote\EnrichOrderShippingDescription"
                sortOrder="10" />
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="dhlparcel_drop_off_point_listing_data_source"
                      xsi:type="string">Ideo\Dhl\Model\ResourceModel\DropOffPoint\Grid\Collection</item>
                <item name="dhlparcel_delivery_service_listing_data_source"
                      xsi:type="string">Ideo\Dhl\Model\ResourceModel\DeliveryService\Grid\Collection</item>
                <item name="dhlparcel_shipment_listing_data_source"
                      xsi:type="string">Ideo\Dhl\Model\ResourceModel\ShipmentData\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
