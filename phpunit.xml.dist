<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * Modeled after Magento core dev/tests/unit/phpunit.xml.dist
 */
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         colors="true"
         columns="max"
         beStrictAboutTestsThatDoNotTestAnything="false"
         bootstrap="Test/bootstrap.php"
         cacheDirectory=".phpunit.result.cache">
    <testsuites>
        <testsuite name="Ideo_Dhl_Unit_Tests">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">Api</directory>
            <directory suffix=".php">Block</directory>
            <directory suffix=".php">Controller</directory>
            <directory suffix=".php">Logger</directory>
            <directory suffix=".php">Model</directory>
            <directory suffix=".php">Plugin</directory>
            <directory suffix=".php">Setup</directory>
            <directory suffix=".php">Ui</directory>
            <directory suffix=".php">ViewModel</directory>
        </include>
    </source>
    <php>
        <includePath>.</includePath>
        <ini name="memory_limit" value="-1"/>
        <ini name="date.timezone" value="UTC"/>
    </php>
</phpunit>
